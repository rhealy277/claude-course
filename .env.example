# ===========================================
# Attio Prospect Follow-Up Tracker
# Copy this file to .env and fill in values
# ===========================================

# --- Attio CRM ---
# Get your API key from: Attio > Settings > Developers > API Keys
ATTIO_API_KEY=your_attio_api_key

# --- Google (OAuth) ---
# Download credentials.json from Google Cloud Console
# Then run: python setup_google.py
GOOGLE_CREDENTIALS_PATH=./credentials.json
MY_EMAIL=you@yourdomain.com

# --- Granola Meeting Notes ---
# Get from: ~/Library/Application Support/Granola/supabase.json
GRANOLA_REFRESH_TOKEN=your_initial_refresh_token
GRANOLA_CLIENT_ID=your_granola_client_id

# --- Claude AI (Anthropic) ---
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key

# --- Slack ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# --- Optional Settings ---
TIMEZONE=America/New_York
MEETING_DURATION_MINUTES=30
AVAILABILITY_WINDOW_START=09:00
AVAILABILITY_WINDOW_END=17:00
